+    uint32_t b=mui_mouse(f,m,true,0);
+    if(f%2==0){ uint32_t e=b&~prev; prev=b;
+      if(e&0x20){ int i=sel+1; while(i<6&&dis[i]) i++; if(i<6) sel=i; }
+      if(e&0x80){ int i=sel-1; while(i>=0&&dis[i]) i--; if(i>=0) sel=i; }
+      if(e&0x4000){ xs++; if(sel!=target) printf("X FORA "); }
+    }
+  }
+  bool ok= sel==target && xs==(modo==0?1:0);
+  printf("%d %d modo=%d alvo=%d final=%d X=%d\n",ok,seed,modo,target,sel,xs);
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/hover_duelo.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/hover_duelo.cpp
--- a/tools/teste_mouse/hover_duelo.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/teste_mouse/hover_duelo.cpp	2026-10-19 15:30:25.647646442 +0000
@@ -0,0 +1,49 @@
+// Passar o mouse no duelo. Modelo do campo igual ao campo.cpp (geometria medida).
+// Roteiro: 1) mouse passeia pelas cartas e para numa: a maozinha tem que ir ate ela, sem nenhum X.
+//          2) jogador aperta X no teclado: abre janelinha (o direcional passa a mexer a janela). Mouse passeia: NENHUM toque deve chegar a janela.
+//          3) jogador aperta O: janela fecha. Mouse para numa carta: a maozinha tem que ir ate ela de novo.
+#include "mouse_ui.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <random>
+#include <algorithm>
+struct C { int row, x, y, w, h, px, py; };
+int main(int argc,char**argv){
+  int seed=atoi(argv[1]); std::mt19937 rng(seed); int lag=3+rng()%3;
+  std::vector<C> cs; int zx[5]={183,226,270,314,357};
+  for(int r=0;r<3;r++) for(int z=0;z<5;z++) if(rng()%2){ if(r==0) cs.push_back({0,zx[z]-17,102,33,15,17,-3}); if(r==1) cs.push_back({1,zx[z]-14,143,28,27,14,2}); if(r==2) cs.push_back({2,zx[z]-15,176,30,32,15,5}); }
+  int nh=3+rng()%4, hx0=240-nh*47/2; for(int i=0;i<nh;i++) cs.push_back({3,hx0+47*i,219,45,64,17,-13});
+  int n=cs.size();
+  auto rowcards=[&](int r){ std::vector<int> v; for(int i=0;i<n;i++) if(cs[i].row==r) v.push_back(i); std::sort(v.begin(),v.end(),[&](int a,int b){return cs[a].x<cs[b].x;}); return v; };
+  int sel; { auto h=rowcards(3); sel=h[rng()%h.size()]; }
+  int t1=rng()%n, t3=rng()%n;
+  std::vector<int> hist; uint32_t prev=0; int xs=0, popup_moves=0; bool popup=false; int sel_at_1=-1;
+  auto mouse_on=[&](int i,int&mx,int&my){ const C&c=cs[i]; mx=c.x+c.w/2; my=(c.row==3?250:c.y+c.h/2); };
+  for(int f=1;f<900;f++){
+    hist.push_back(sel); int ds=hist.size()>(size_t)lag?hist[hist.size()-1-lag]:hist[0];
+    for(int i=0;i<n;i++){ const C&c=cs[i]; int y=c.y-(c.row==3&&i==ds?13:0); mui_quad(0,c.x,y,c.x+c.w,y+c.h,0x98b4e40); mui_quad(0,c.x,y,c.x+c.w,y+c.h,0x9d00000+i*0x800); }
+    { const C&c=cs[ds]; mui_prim(0,c.x+c.px,c.y+c.py,c.x+c.px+32,c.y+c.py+32,64,96,96,128,0x9925340,0); }
+    mui_set_frame(0);
+    int mx=5,my=5, kb=0;
+    if(f<200){ if(f<150){ int k=(f/9)%n; mouse_on(k,mx,my); mx+= (f%3)-1; } else mouse_on(t1,mx,my); }
+    else if(f==260) kb=0x4000;                                  // X no teclado: abre a janelinha
+    else if(f>270 && f<500){ int k=(f/7)%n; mouse_on(k,mx,my); mx+=(f%5)-2; }   // passeia com a janela aberta
+    else if(f==520) kb=0x2000;                                  // O: fecha
+    else if(f>540){ mouse_on(t3,mx,my); if(f<560) mx+=f%4; }
+    if(f==200) sel_at_1=sel;
+    MuiMouse m{}; m.in_client=true; m.inside=mx>20; m.mx=mx; m.my=my;
+    uint32_t b=mui_mouse(f,m,true,kb) | kb;
+    if(f%2==0){ uint32_t e=b&~prev; prev=b;
+      if(e&0x4000){ xs++; if(f>=255&&f<=265) popup=true; }
+      if(e&0x2000) popup=false;
+      if(popup){ if(e&0xf0) popup_moves++; }
+      else {
+        if(e&0xa0){ auto v=rowcards(cs[sel].row); int k=std::find(v.begin(),v.end(),sel)-v.begin(); if(e&0x20&&k+1<(int)v.size()) sel=v[k+1]; if(e&0x80&&k>0) sel=v[k-1]; }
+        if(e&0x50){ int d=(e&0x40)?1:-1; for(int r=cs[sel].row+d;r>=0&&r<=3;r+=d){ auto v=rowcards(r); if(v.empty()) continue; int bi=v[0]; for(int i:v) if(std::abs(cs[i].x+cs[i].w/2-(cs[sel].x+cs[sel].w/2))<std::abs(cs[bi].x+cs[bi].w/2-(cs[sel].x+cs[sel].w/2))) bi=i; sel=bi; break; } }
+      }
+    }
+  }
+  bool ok = sel_at_1==t1 && sel==t3 && popup_moves==0 && xs==1;
+  printf("%d %d cartas=%d alvo1=%d chegou1=%d alvo3=%d final=%d toques_na_janela=%d X=%d\n",ok,seed,n,t1,sel_at_1,t3,sel,popup_moves,xs);
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/loja.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/loja.cpp
--- a/tools/teste_mouse/loja.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/teste_mouse/loja.cpp	2026-10-20 17:42:11.375938053 +0000
@@ -0,0 +1,40 @@
+// Simula a loja (grade de pacotes 12x4, casas a cada 22x47 px, divisores 2x8 no alto de cada casa) com a moldura de 4 cantos que pulsa,
+// casas vazias (sem pacote desenhado, mas o cursor passa por elas) e o atraso medido na gravacao 143802 (~5 quadros).
+// modo 0 = clicando num pacote; modo 1 = so passando o mouse (o cursor tem que terminar na casa, sem X)
+#include "mouse_ui.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <random>
+int main(int argc,char**argv){
+  int seed=atoi(argv[1]), modo=atoi(argv[2]); std::mt19937 rng(seed);
+  const int C=12, R=4; int lag=4+rng()%3; int sel=rng()%(C*R), target; do target=rng()%(C*R); while(target==sel);
+  std::vector<int> hist; uint32_t prev=0; int xs=0, fx=-1, fchega=-1;
+  bool vazia[C*R]; for(int i=0;i<C*R;i++) vazia[i]=rng()%3==0;
+  int clickf=30+rng()%40, hold=2+rng()%15;
+  for(int f=1;f<500;f++){
+    hist.push_back(sel); int ds=hist.size()>(size_t)lag?hist[hist.size()-1-lag]:hist[0];
+    mui_prim(0,0,0,64,256,0,0,64,256,9,0);                    // fundo
+    for(int r=0;r<R;r++) for(int c=0;c<C;c++){ int x=86+22*c, y=5+47*r;
+      mui_prim(0,x+9,y-1,x+11,y+7,131,144,133,152,7,0);       // divisor 2x8
+      if(!vazia[r*C+c]){ mui_prim(0,x,y,x+20,y+40,0,0,20,40,8,0); mui_prim(0,x,y,x+24,y+44,50,164,74,208,7,0); } }
+    { int c=ds%C, r=ds/C, x=86+22*c, y=5+47*r, p=(f/4)%5-2;   // moldura de 4 cantos pulsando, centro fixo
+      int l=x-3-p, t=y-3-p, rr=x+23+p, b=y+43+p;
+      mui_prim(0,l,t,l+12,t+12,0,214,12,226,7,0); mui_prim(0,rr-12,t,rr,t+12,12,214,0,226,7,0);
+      mui_prim(0,l,b-12,l+12,b,0,226,12,214,7,0); mui_prim(0,rr-12,b-12,rr,b,12,226,0,214,7,0); }
+    mui_set_frame(0);
+    int tx=86+22*(target%C)+11, ty=5+47*(target/C)+20;
+    MuiMouse m{}; m.in_client=m.inside=true;
+    if(f<clickf){ int k=(f/7)%(C*R); m.mx=modo==1?86+22*(k%C)+11:10; m.my=modo==1?5+47*(k/C)+20:250; } else { m.mx=tx+(f%3)-1; m.my=ty; }
+    if(modo==0){ m.down[0]=f>=clickf&&f<clickf+hold; m.clicked[0]=f==clickf; }
+    uint32_t b=mui_mouse(f,m,true,0);
+    if(f%2==0){ uint32_t e=b&~prev; prev=b; int r=sel/C, c=sel%C, old=sel;
+      if(e&0x20 && c<C-1) sel++; if(e&0x80 && c>0) sel--; if(e&0x40 && r<R-1) sel+=C; if(e&0x10 && r>0) sel-=C;
+      if(e&0x4000){ xs++; if(sel!=target) printf("X FORA DO ALVO "); if(fx<0) fx=f; }
+      if(sel!=old && sel!=target) fchega=-1; if(f>=clickf && sel==target && fchega<0) fchega=f; }
+  }
+  bool ok = modo==0 ? (xs==1 && sel==target) : (xs==0 && sel==target);
+  printf("%d %d modo=%d lag=%d alvo=%d final=%d X=%d", ok, seed, modo, lag, target, sel, xs);
+  if(getenv("TF_TEMPO")) printf(" tempo=%d", modo==0 ? (fx<0?-1:fx-clickf) : (fchega<0?-1:fchega-clickf));
+  printf("\n");
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/mapa.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/mapa.cpp
--- a/tools/teste_mouse/mapa.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/teste_mouse/mapa.cpp	2026-10-19 15:30:25.647657526 +0000
@@ -0,0 +1,36 @@
+// Mapa da escola (Modo Historia): 12 lugares nas posicoes da gravacao F4, quads 16x16 desenhados 2x; setinha 16x16 balancando 16-20 px acima
+// do lugar escolhido, que some 5 quadros enquanto anda. Direcional: vai ao lugar mais perto naquela direcao (dentro de 60 graus).
+// modo 0 = clicar num lugar; modo 1 = passar o mouse e parar num lugar.
+#include "mouse_ui.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+#include <vector>
+#include <random>
+int main(int argc,char**argv){
+  int seed=atoi(argv[1]), modo=atoi(argv[2]); std::mt19937 rng(seed); int lag=3+rng()%3;
+  int P[12][2]={{311,41},{202,78},{113,82},{81,121},{315,128},{391,132},{118,139},{23,146},{197,157},{266,168},{340,179},{8,216}};
+  int sel=rng()%12, target; do target=rng()%12; while(target==sel);
+  auto step=[&](int s,int dx,int dy){ int best=-1; double bd=1e9; for(int i=0;i<12;i++){ if(i==s) continue; double vx=P[i][0]-P[s][0], vy=P[i][1]-P[s][1], L=std::hypot(vx,vy); double cosv=(vx*dx+vy*dy)/L; if(cosv<0.5) continue; if(L<bd){bd=L;best=i;} } return best<0?s:best; };
+  std::vector<int> hist; uint32_t prev=0; int xs=0, moved_at=-100, clickf=40+rng()%30;
+  for(int f=1;f<900;f++){
+    hist.push_back(sel); int ds=hist.size()>(size_t)lag?hist[hist.size()-1-lag]:hist[0];
+    for(int i=0;i<12;i++){ mui_quad(0,P[i][0],P[i][1],P[i][0]+16,P[i][1]+16,0x9867fc0); mui_quad(0,P[i][0],P[i][1],P[i][0]+16,P[i][1]+16,0x9868230); }
+    mui_quad(0,0,0,511,257,0x9876530); mui_quad(0,201,199,265,263,0x9874a50);
+    bool anim = f-moved_at < lag+5;
+    if(!anim){ int bob=(f/6)%5; mui_quad(0,P[ds][0],P[ds][1]-16-bob,P[ds][0]+16,P[ds][1]-bob,0x9868dd0); mui_quad(0,P[ds][0]-8,P[ds][1]-8,P[ds][0]+24,P[ds][1]+24,0x9868a60); }
+    mui_set_frame(0);
+    int mx=P[target][0]+8, my=P[target][1]+8;
+    if(modo==1 && f<clickf){ int k=(f/10)%12; mx=P[k][0]+8; my=P[k][1]+8; }
+    MuiMouse m{}; m.in_client=m.inside=true; m.mx=(modo==0&&f<clickf)?470:mx; m.my=(modo==0&&f<clickf)?260:my;
+    if(modo==0){ m.down[0]=f>=clickf&&f<clickf+4; m.clicked[0]=f==clickf; }
+    uint32_t b=mui_mouse(f,m,true,0);
+    if(f%2==0){ uint32_t e=b&~prev; prev=b; int old=sel;
+      if(e&0x20) sel=step(sel,1,0); else if(e&0x80) sel=step(sel,-1,0); else if(e&0x40) sel=step(sel,0,1); else if(e&0x10) sel=step(sel,0,-1);
+      if(sel!=old) moved_at=f;
+      if(e&0x4000){ xs++; if(sel!=target) printf("X FORA "); }
+    }
+  }
+  bool ok= sel==target && xs==(modo==0?1:0);
+  printf("%d %d modo=%d alvo=%d final=%d X=%d\n",ok,seed,modo,target,sel,xs);
+}
