@@ -0,0 +1,52 @@
+// Simula o Deck Edit (grade 11x4, 42 cartas) e a mao do duelo (4..6 cartas) com a geometria e o atraso medidos nas gravacoes F4.
+// modo 0 = Deck Edit, 1 = mao do duelo, 2 = mao com janelinha aberta (o direcional mexe a janela, nao o cursor; X confirma a janela)
+#include "mouse_ui.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <random>
+int main(int argc,char**argv){
+  int seed=atoi(argv[1]), modo=atoi(argv[2]); std::mt19937 rng(seed);
+  int lag=3+rng()%4;
+  int ncards = modo==0 ? 30+rng()%13 : 4+rng()%3;   // Deck Edit: 30..42 cartas; mao: 4..6
+  int cols = modo==0 ? 11 : ncards;
+  int sel=rng()%ncards; std::vector<int> hist; uint32_t prev=0;
+  int target; do target=rng()%ncards; while(modo==2 && target==sel);
+  int clickf=40+rng()%40, hold=2+rng()%15;
+  int xs=0, popup_moves=0, cursor_moves=0, at_click=-1;
+  for(int f=1;f<520;f++){
+    hist.push_back(sel); int ds=hist.size()>(size_t)lag?hist[hist.size()-1-lag]:hist[0];
+    if(modo==0){
+      for(int i=0;i<ncards;i++){ int x=156+28*(i%11), y=46+34*(i/11); mui_prim(0,x,y,x+22,y+30,0,0,22,30,0x9a00000+(i%5)*0x40000,0); mui_prim(0,x+1,y+1,x+23,y+31,0,0,22,30,0x9a00000+(i%5)*0x40000,0); }
+      int x=156+28*(ds%11)-4, y=46+34*(ds/11)-4, X=x+33, Y=y+41; uint32_t T=0x9cb2de0;
+      mui_prim(0,x,y,x+6,y+6,213,122,219,128,T,0); mui_prim(0,X-6,y,X,y+6,250,122,256,128,T,0); mui_prim(0,x,Y-6,x+6,Y,213,159,219,165,T,0); mui_prim(0,X-6,Y-6,X,Y,250,159,256,165,T,0);
+      mui_prim(0,x,y+6,x+6,Y-6,213,128,219,129,T,0); mui_prim(0,X-6,y+6,X,Y-6,250,128,256,129,T,0); mui_prim(0,x+6,y,X-6,y+6,219,122,220,128,T,0); mui_prim(0,x+6,Y-6,X-6,Y,219,159,220,165,T,0);
+    } else {
+      int x0=240-ncards*47/2;
+      for(int i=0;i<ncards;i++){ int x=x0+47*i, y=(i==ds)?206:219; mui_quad(0,x,y,x+45,y+64,0x98b4e40); mui_quad(0,x,y,x+45,y+64,0x98b4e40); }
+      mui_prim(0,x0+47*ds+17,193,x0+47*ds+49,225,0,0,32,32,0x9925340,0);   // maozinha
+    }
+    mui_set_frame(0);
+    // mouse: em cima do alvo a partir do clique
+    int tx,ty; if(modo==0){ tx=156+28*(target%11)+11; ty=46+34*(target/11)+15; } else { int x0=240-ncards*47/2; tx=x0+47*target+22; ty=245; }
+    MuiMouse m{}; m.in_client=m.inside=true; m.mx=f<clickf?10:tx; m.my=f<clickf?10:ty; m.down[0]=f>=clickf&&f<clickf+hold; m.clicked[0]=f==clickf;
+    uint32_t b=mui_mouse(f,m,true,0);
+    if(f==clickf) at_click=sel;
+    if(f%2==0){ uint32_t e=b&~prev; prev=b;
+      if(modo==2){ if(e&0xf0) popup_moves++; if(e&0x4000) xs++; }
+      else {
+        int r=sel/cols, c=sel%cols, old=sel;
+        if(e&0x20 && c<cols-1 && sel+1<ncards) sel++;
+        if(e&0x80 && c>0) sel--;
+        if(e&0x40 && modo==0 && r<3){ sel=std::min(ncards-1, sel+11); }
+        if(e&0x10 && modo==0 && r>0) sel-=11;
+        if(sel!=old) cursor_moves++;
+        if(e&0x4000){ xs++; if(sel!=target) printf("X FORA DO ALVO "); }
+      }
+    }
+  }
+  bool ok;
+  if(modo==2) ok = xs==0;   // janelinha: nada de X, e desiste logo
+  else ok = xs==1 && sel==target;
+  printf("%d %d modo=%d cartas=%d lag=%d de=%d alvo=%d final=%d X=%d passos=%d janela=%d\n",ok,seed,modo,ncards,lag,at_click,target,sel,xs,cursor_moves,popup_moves);
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/cenarios.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/cenarios.cpp
--- a/tools/teste_mouse/cenarios.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/teste_mouse/cenarios.cpp	2026-10-18 21:11:39.472536522 +0000
@@ -0,0 +1,79 @@
+// Simulador: um "jogo" PSP com uma lista vertical de barras, lido pelo modulo do mouse do mesmo jeito que no runtime.
+#include "mouse_ui.h"
+#include <cstdio>
+#include <vector>
+#include <functional>
+#include <string>
+#include <cstdlib>
+struct Ev { bool inside=false; int mx=0,my=0; bool ldown=false; bool lclick=false; };
+struct Result { std::vector<std::pair<int,int>> confirms; /* (item, tela) */ int final_sel; int moves; };
+struct Game; static int bar_y(int i){ return 50+i*30; }
+static int center_y(int i){ return bar_y(i)+10; }
+struct Game {
+  int n=5, sel=0, screen=0, lag=2; int closing=0; static int close_anim; std::vector<int> hist; uint32_t prevpoll=0; int moves=0;
+  std::function<bool(int)> blink=[](int){return false;};
+  Result r;
+  void draw(int f){
+    hist.push_back(sel);
+    int ds = hist.size()>(size_t)lag ? hist[hist.size()-1-lag] : hist[0];
+    uint32_t fb=0x04000000;
+    if(closing>0) closing--;
+    if(screen==0 || closing>0) for(int i=0;i<n;i++){
+      uint32_t tex = (i==ds && !blink(f)) ? 2 : 1; int y=bar_y(i);
+      mui_prim(fb,100,y,116,y+20,0,0,16,20,tex,0xffffffff);
+      mui_prim(fb,116,y,284,y+20,16,0,32,20,tex,0xffffffff);
+      mui_prim(fb,284,y,300,y+20,32,0,48,20,tex,0xffffffff);
+    }
+    mui_set_frame(fb);
+  }
+  void input(int f,uint32_t b){
+    if(f%2) return;            // o jogo le o controle a cada 2 quadros
+    uint32_t e=b&~prevpoll; prevpoll=b;
+    if(screen==0){
+      if(e&0x10 && sel>0){sel--;moves++;} if(e&0x40 && sel<n-1){sel++;moves++;}
+      if(e&0x4000){ r.confirms.push_back({sel,screen}); screen=1; closing=close_anim; }
+    } else if(e&0x4000) r.confirms.push_back({-1,screen});
+  }
+};
+int Game::close_anim=0;
+static Result run(std::function<Ev(int)> script,int frames=300,std::function<bool(int)> blink=nullptr,bool menus=true){
+  Game g; if(blink) g.blink=blink;
+    uint32_t b=0;
+  for(int f=1;f<frames;f++){
+    g.draw(f);
+    Ev e=script(f);
+    MuiMouse m{}; m.in_client=true; m.inside=e.inside; m.mx=e.mx; m.my=e.my; m.down[MUI_BL]=e.ldown; m.clicked[MUI_BL]=e.lclick;
+    b=mui_mouse(f,m,menus,0);
+    g.input(f,b);
+  }
+  g.r.final_sel=g.sel; g.r.moves=g.moves; return g.r;
+}
+static void show(const char*name,const Result&r,const char*expect){
+  std::string s; for(auto&c:r.confirms){ char t[40]; snprintf(t,sizeof t,"%s%d@tela%d",s.empty()?"":", ",c.first,c.second); s+=t; }
+  printf("%-58s confirmou: [%s]  (esperado: %s)\n",name,s.c_str(),expect);
+}
+int main(int argc,char**argv){ int only=argc>1?atoi(argv[1]):0; int k=0;
+#define SC if(++k==only)
+  // S1: passa o mouse no item 3, espera, clique normal (6 quadros)
+  SC show("S1 hover no 3 e clique normal",run([](int f){Ev e; e.inside=true; e.mx=200; e.my=center_y(3); e.ldown=(f>=80&&f<86); e.lclick=(f==80); return e;}),"3 uma vez");
+  // S2: clique direto no 4 segurando ~250 ms (15 quadros) sem hover antes
+  SC show("S2 clique direto no 4 segurando 250 ms",run([](int f){Ev e; e.inside=f>=40; e.mx=200; e.my=center_y(4); e.ldown=(f>=40&&f<55); e.lclick=(f==40); return e;}),"4 uma vez");
+  // S3: clique segurado 400 ms no item ja selecionado
+  SC show("S3 hover no 2, clique segurado 400 ms",run([](int f){Ev e; e.inside=true; e.mx=200; e.my=center_y(2); e.ldown=(f>=80&&f<104); e.lclick=(f==80); return e;}),"2 uma vez");
+  // S4: clica no 4 e o mouse escorrega para o 1 logo depois
+  SC show("S4 clica no 4, mouse escorrega para o 1",run([](int f){Ev e; e.inside=true; e.mx=200; e.my=center_y(f<44?4:1); e.ldown=(f>=40&&f<44); e.lclick=(f==40); return e;}),"4 uma vez");
+  // S5: clique muito curto (1 quadro, entre leituras do jogo) sem menus (so X)
+  SC show("S5 clique de 1 quadro, mouse nos menus desligado",run([](int f){Ev e; e.ldown=(f==41); e.lclick=(f==41); return e;},300,nullptr,false),"1 X (item 0)");
+  // S6: clique em quadro impar com botao ja solto na leitura (clique so visto pela mensagem)
+  SC show("S6 clique inteiro entre leituras (so a mensagem viu)",run([](int f){Ev e; e.lclick=(f==41); return e;},300,nullptr,false),"1 X (item 0)");
+  // S7: realce pisca (some 2 de cada 8 quadros) e o clique cai num quadro sem realce
+  SC show("S7 realce piscando, clique no 3",run([](int f){Ev e; e.inside=true; e.mx=200; e.my=(f<70?center_y(0):center_y(3)); e.ldown=(f>=70&&f<74); e.lclick=(f==70); return e;},300,[](int f){return (f%8)>=6 || (f>=66&&f<=72);}),"3 uma vez");
+  // S8: mouse varrendo a lista de cima a baixo devagar, mexendo 1 px por quadro dentro das barras (sem clique)
+  SC show("S4b vai ao 4 so no clique e escorrega para o 1",run([](int f){Ev e; e.inside=true; e.mx=200; e.my=center_y(f<40?0:(f<44?4:1)); e.ldown=(f>=40&&f<44); e.lclick=(f==40); return e;}),"4 uma vez");
+  SC { Game::close_anim=10; show("S9 clique segurado 300 ms, menu fecha com animacao",run([](int f){Ev e; e.inside=true; e.mx=200; e.my=center_y(2); e.ldown=(f>=80&&f<98); e.lclick=(f==80); return e;}),"2 uma vez (sem X extra na tela seguinte)"); }
+  SC { Result r=run([](int f){Ev e; e.inside=true; e.mx=200+(f%3); e.my=(f<30?center_y(0):center_y(4)); return e;},200);
+    printf("%-58s selecao final %d, %d passos dados pelo jogo (esperado: 4, 4 passos)\n","S10 pula para o 4 e o mouse treme dentro da barra",r.final_sel,r.moves); }
+  SC { Result r=run([](int f){Ev e; e.inside=true; e.mx=150+(f%40); e.my=50+f/2; if(e.my>190)e.my=190; return e;},400);
+    printf("%-58s selecao final %d, %d passos dados pelo jogo (esperado: 4, 4 passos)\n","S8 varredura lenta com micro-movimentos",r.final_sel,r.moves); }
+  return 0;
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/fases.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/fases.cpp
--- a/tools/teste_mouse/fases.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/teste_mouse/fases.cpp	2026-10-19 12:13:45.440887840 +0000
@@ -0,0 +1,35 @@
+// Selecao de fase (geometria medida): 6 icones 20x32 em y=124, passo 40, x=204..404; realce = moldura de 9 pedacos com 5 px de folga.
+// Fases indisponiveis (desenhadas com v=32) sao puladas pelo jogo. modo 0: clicar numa fase; modo 1: passar o mouse e parar numa fase.
+#include "mouse_ui.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <random>
+int main(int argc,char**argv){
+  int seed=atoi(argv[1]), modo=atoi(argv[2]); std::mt19937 rng(seed); int lag=2+rng()%4;
+  bool dis[6]; int sel=2+rng()%2; for(int i=0;i<6;i++) dis[i]= i!=sel && rng()%3==0;
+  int target; do target=rng()%6; while(dis[target]);
+  std::vector<int> hist; uint32_t prev=0; int xs=0; int clickf=40+rng()%30;
+  for(int f=1;f<500;f++){
+    hist.push_back(sel); int ds=hist.size()>(size_t)lag?hist[hist.size()-1-lag]:hist[0];
+    for(int i=0;i<6;i++){ int x=204+40*i; float v=dis[i]?32:0; mui_prim(0,x,124,x+20,156,i*20.f,v,i*20.f+20,v+32,0x99ba7c0,0xffffffff); if(i<5) mui_prim(0,x+27,135,x+34,146,120,32,127,43,0x99ba7c0,0xffffffff); }
+    int hx=204+40*ds-5; uint32_t T=0x88951f0, C=0xa70080ff;
+    mui_prim(0,hx,120,hx+4,124,0,112,4,116,T,C); mui_prim(0,hx+4,120,hx+26,124,4,112,8,116,T,C); mui_prim(0,hx+26,120,hx+30,124,8,112,12,116,T,C);
+    mui_prim(0,hx,124,hx+4,156,0,116,4,120,T,C); mui_prim(0,hx+4,124,hx+26,156,4,116,8,120,T,C); mui_prim(0,hx+26,124,hx+30,156,8,116,12,120,T,C);
+    mui_prim(0,hx,156,hx+4,160,0,120,4,124,T,C); mui_prim(0,hx+4,156,hx+26,160,4,120,8,124,T,C); mui_prim(0,hx+26,156,hx+30,160,8,120,12,124,T,C);
+    mui_quad(0,267,219,312,283,0x98b4e40); mui_quad(0,314,219,360,283,0x98b4e40);   // cartas da mao ao fundo
+    mui_set_frame(0);
+    int mx=204+40*target+10, my=140;
+    if(modo==1 && f<clickf){ int k=(f/9)%6; mx=204+40*k+10; }
+    MuiMouse m{}; m.in_client=m.inside=true; m.mx=(modo==0&&f<clickf)?5:mx; m.my=(modo==0&&f<clickf)?5:my;
+    if(modo==0){ m.down[0]=f>=clickf&&f<clickf+4; m.clicked[0]=f==clickf; }
+    uint32_t b=mui_mouse(f,m,true,0);
+    if(f%2==0){ uint32_t e=b&~prev; prev=b;
+      if(e&0x20){ int i=sel+1; while(i<6&&dis[i]) i++; if(i<6) sel=i; }
+      if(e&0x80){ int i=sel-1; while(i>=0&&dis[i]) i--; if(i>=0) sel=i; }
+      if(e&0x4000){ xs++; if(sel!=target) printf("X FORA "); }
+    }
+  }
+  bool ok= sel==target && xs==(modo==0?1:0);
+  printf("%d %d modo=%d alvo=%d final=%d X=%d\n",ok,seed,modo,target,sel,xs);
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/hover_duelo.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/hover_duelo.cpp
--- a/tools/teste_mouse/hover_duelo.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/teste_mouse/hover_duelo.cpp	2026-10-19 11:01:54.269006469 +0000
@@ -0,0 +1,49 @@
+// Passar o mouse no duelo. Modelo do campo igual ao campo.cpp (geometria medida).
+// Roteiro: 1) mouse passeia pelas cartas e para numa: a maozinha tem que ir ate ela, sem nenhum X.
+//          2) jogador aperta X no teclado: abre janelinha (o direcional passa a mexer a janela). Mouse passeia: NENHUM toque deve chegar a janela.
+//          3) jogador aperta O: janela fecha. Mouse para numa carta: a maozinha tem que ir ate ela de novo.
+#include "mouse_ui.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <random>
+#include <algorithm>
+struct C { int row, x, y, w, h, px, py; };
+int main(int argc,char**argv){
+  int seed=atoi(argv[1]); std::mt19937 rng(seed); int lag=3+rng()%3;
+  std::vector<C> cs; int zx[5]={183,226,270,314,357};
+  for(int r=0;r<3;r++) for(int z=0;z<5;z++) if(rng()%2){ if(r==0) cs.push_back({0,zx[z]-17,102,33,15,17,-3}); if(r==1) cs.push_back({1,zx[z]-14,143,28,27,14,2}); if(r==2) cs.push_back({2,zx[z]-15,176,30,32,15,5}); }
+  int nh=3+rng()%4, hx0=240-nh*47/2; for(int i=0;i<nh;i++) cs.push_back({3,hx0+47*i,219,45,64,17,-13});
+  int n=cs.size();
+  auto rowcards=[&](int r){ std::vector<int> v; for(int i=0;i<n;i++) if(cs[i].row==r) v.push_back(i); std::sort(v.begin(),v.end(),[&](int a,int b){return cs[a].x<cs[b].x;}); return v; };
+  int sel; { auto h=rowcards(3); sel=h[rng()%h.size()]; }
+  int t1=rng()%n, t3=rng()%n;
+  std::vector<int> hist; uint32_t prev=0; int xs=0, popup_moves=0; bool popup=false; int sel_at_1=-1;
+  auto mouse_on=[&](int i,int&mx,int&my){ const C&c=cs[i]; mx=c.x+c.w/2; my=(c.row==3?250:c.y+c.h/2); };
+  for(int f=1;f<900;f++){
+    hist.push_back(sel); int ds=hist.size()>(size_t)lag?hist[hist.size()-1-lag]:hist[0];
+    for(int i=0;i<n;i++){ const C&c=cs[i]; int y=c.y-(c.row==3&&i==ds?13:0); mui_quad(0,c.x,y,c.x+c.w,y+c.h,0x98b4e40); mui_quad(0,c.x,y,c.x+c.w,y+c.h,0x9d00000+i*0x800); }
+    { const C&c=cs[ds]; mui_prim(0,c.x+c.px,c.y+c.py,c.x+c.px+32,c.y+c.py+32,64,96,96,128,0x9925340,0); }
+    mui_set_frame(0);
+    int mx=5,my=5, kb=0;
+    if(f<200){ if(f<150){ int k=(f/9)%n; mouse_on(k,mx,my); mx+= (f%3)-1; } else mouse_on(t1,mx,my); }
+    else if(f==260) kb=0x4000;                                  // X no teclado: abre a janelinha
+    else if(f>270 && f<500){ int k=(f/7)%n; mouse_on(k,mx,my); mx+=(f%5)-2; }   // passeia com a janela aberta
+    else if(f==520) kb=0x2000;                                  // O: fecha
+    else if(f>540){ mouse_on(t3,mx,my); if(f<560) mx+=f%4; }
+    if(f==200) sel_at_1=sel;
+    MuiMouse m{}; m.in_client=true; m.inside=mx>20; m.mx=mx; m.my=my;
+    uint32_t b=mui_mouse(f,m,true,kb) | kb;
+    if(f%2==0){ uint32_t e=b&~prev; prev=b;
+      if(e&0x4000){ xs++; if(f>=255&&f<=265) popup=true; }
+      if(e&0x2000) popup=false;
+      if(popup){ if(e&0xf0) popup_moves++; }
+      else {
+        if(e&0xa0){ auto v=rowcards(cs[sel].row); int k=std::find(v.begin(),v.end(),sel)-v.begin(); if(e&0x20&&k+1<(int)v.size()) sel=v[k+1]; if(e&0x80&&k>0) sel=v[k-1]; }
+        if(e&0x50){ int d=(e&0x40)?1:-1; for(int r=cs[sel].row+d;r>=0&&r<=3;r+=d){ auto v=rowcards(r); if(v.empty()) continue; int bi=v[0]; for(int i:v) if(std::abs(cs[i].x+cs[i].w/2-(cs[sel].x+cs[sel].w/2))<std::abs(cs[bi].x+cs[bi].w/2-(cs[sel].x+cs[sel].w/2))) bi=i; sel=bi; break; } }
+      }
+    }
+  }
+  bool ok = sel_at_1==t1 && sel==t3 && popup_moves==0 && xs==1;
+  printf("%d %d cartas=%d alvo1=%d chegou1=%d alvo3=%d final=%d toques_na_janela=%d X=%d\n",ok,seed,n,t1,sel_at_1,t3,sel,popup_moves,xs);
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/reproduzir_gravacao.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/reproduzir_gravacao.cpp
--- a/tools/teste_mouse/reproduzir_gravacao.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/teste_mouse/reproduzir_gravacao.cpp	2026-10-18 23:04:36.740786454 +0000
@@ -0,0 +1,30 @@
+// Passa uma gravacao F4 de verdade pelo modulo e imprime o que ele detecta (cartas, cursor) a cada mudanca.
+#include "mouse_ui.cpp"
+#include <fstream>
+#include <sstream>
+struct L { char t; int a[4]; float uv[4]; uint32_t tex, col; };
+int main(int argc,char**argv){
+  std::ifstream in(argv[1]); std::string line;
+  std::vector<std::pair<uint64_t,std::vector<L>>> frames; std::vector<L> last;
+  while(std::getline(in,line)){
+    if(line.empty()||line[0]=='#') continue;
+    std::istringstream ss(line); char t; ss>>t;
+    if(t=='F'){ uint64_t fr; std::string a; ss>>fr>>a; if(a=="same") frames.push_back({fr,last}); else frames.push_back({fr,{}}); continue; }
+    if(frames.empty()) continue;
+    L l{}; l.t=t; std::string tx,cl;
+    if(t=='S'){ ss>>l.a[0]>>l.a[1]>>l.a[2]>>l.a[3]>>l.uv[0]>>l.uv[1]>>l.uv[2]>>l.uv[3]>>tx>>cl; l.tex=strtoul(tx.c_str(),0,16); l.col=strtoul(cl.c_str(),0,16); }
+    else if(t=='R'){ ss>>l.a[0]>>l.a[1]>>l.a[2]>>l.a[3]; }
+    else if(t=='Q'){ ss>>l.a[0]>>l.a[1]>>l.a[2]>>l.a[3]>>tx; l.tex=strtoul(tx.c_str(),0,16); }
+    else continue;
+    frames.back().second.push_back(l); last=frames.back().second;
+  }
+  std::string prev; int n=0, ni=0, ns=0;
+  for(auto &f:frames){
+    for(auto &l:f.second){ if(l.t=='S') mui_prim(0,l.a[0],l.a[1],l.a[2],l.a[3],l.uv[0],l.uv[1],l.uv[2],l.uv[3],l.tex,l.col); else if(l.t=='R') mui_run(0,l.a[0],l.a[1],l.a[2],l.a[3]); else mui_quad(0,l.a[0],l.a[1],l.a[2],l.a[3],l.tex); }
+    mui_set_frame(0); n++; if(!g_items.empty()) ni++; if(g_isel>=0) ns++;
+    char b[200]; snprintf(b,sizeof b,"modo=%d cartas=%zu cursor=%d",g_imode,g_items.size(),g_isel); std::string k=b;
+    if(g_isel>=0){ snprintf(b,sizeof b," col=%d linha=%d x=%d",g_items[g_isel].col,g_items[g_isel].row,g_items[g_isel].x0); k+=b; }
+    if(argc>2){ printf("%llu %d %d %d %d\n",(unsigned long long)f.first,g_imode,(int)g_items.size(),g_isel>=0?g_items[g_isel].x0:-1,g_isel>=0?g_items[g_isel].y0:-1); } else if(k!=prev){ printf("%llu %s\n",(unsigned long long)f.first,k.c_str()); prev=k; }
+  }
+  printf("# %d quadros, %d com cartas, %d com cursor\n",n,ni,ns);
+}
diff -ruN -x '*.o' orig/tools/teste_mouse/reproduzir_listas.cpp src/tagforcerecomp-preview-master/tools/teste_mouse/reproduzir_listas.cpp
